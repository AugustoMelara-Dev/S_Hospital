# === STAGE 1: Build the frontend React SPA ===
FROM node:22-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
# Install exact dependencies
RUN npm ci --ignore-scripts
COPY frontend/ ./
# Build production assets (vite build outputs to /app/dist)
RUN npm run build

# === STAGE 2: Install backend Composer dependencies ===
FROM composer:2 AS composer-builder
WORKDIR /app
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts --ignore-platform-reqs

# === STAGE 3: Final Production Image (PHP-FPM) ===
FROM php:8.3-fpm-alpine
WORKDIR /var/www/html

# Install production system dependencies
RUN apk add --no-cache \
    bash \
    curl \
    libzip-dev \
    oniguruma-dev \
    zip \
    icu-dev \
    freetype-dev \
    libjpeg-turbo-dev \
    libpng-dev \
    mariadb-client \
    shadow

# Configure and install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install intl mbstring pdo_mysql zip gd opcache bcmath

# Copy OPcache configuration for production performance
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.memory_consumption=256'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'opcache.revalidate_freq=0'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.fast_shutdown=1'; \
        echo 'opcache.enable_file_override=1'; \
    } > /usr/local/etc/php/conf.d/opcache-recommended.ini

# Copy the FPM pool tuning for production. Replaces the upstream
# default of 5 dynamic children (which starves a 5-cashier LAN).
COPY docker/php-fpm.conf /usr/local/etc/php-fpm.d/zz-hospital-tuning.conf

# Copy custom php.ini configuration (upload size, memory limit)
RUN { \
        echo 'upload_max_filesize=32M'; \
        echo 'post_max_size=32M'; \
        echo 'memory_limit=256M'; \
        echo 'max_execution_time=600'; \
    } > /usr/local/etc/php/conf.d/custom-php.ini

# Copy backend application source
COPY backend/ ./

# Copy composer dependencies from Stage 2
COPY --from=composer-builder /app/vendor/ ./vendor/

# Copy built frontend assets from Stage 1
COPY --from=frontend-builder /app/dist/ /var/www/frontend/dist/

# Create public assets directories for Laravel
RUN mkdir -p storage/framework/views storage/framework/cache storage/framework/sessions bootstrap/cache \
    && rm -f bootstrap/cache/*.php

# Adjust directory permissions so php-fpm (www-data) can write to storage & bootstrap
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

COPY backend/docker/entrypoint.sh /usr/local/bin/s-hospital-entrypoint.sh
RUN chmod +x /usr/local/bin/s-hospital-entrypoint.sh

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/s-hospital-entrypoint.sh"]
CMD ["php-fpm"]
