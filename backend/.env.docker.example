# =============================================================================
# Sistema de Caja Hospitalaria - Plantilla backend para Docker
# =============================================================================
# Usado por `docker-compose.yml` y `docker-compose.prod.yml`. El hostname
# del servicio de MariaDB dentro de la red Docker es `mysql` (no
# `127.0.0.1`).
# =============================================================================

APP_NAME="Sistema de Caja Hospitalaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de datos (host = nombre del servicio en docker-compose)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hospital_billing
DB_USERNAME=hospital
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sesion, cache, sanctum
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,::1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@hospital-billing.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Pusher / Soketi (WebSockets para Echo). REQUERIDO en docker-compose.prod.yml.
# Generar valores aleatorios >= 16 chars por hospital.
# Comando sugerido (Linux/PowerShell): openssl rand -hex 16
# No usar defaults. Nunca commitear valores reales.
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# -----------------------------------------------------------------------------
# Salt para firmar license.json. Ver docs/SECRETS.md.
# -----------------------------------------------------------------------------
HOSPITAL_LICENSE_SALT=
