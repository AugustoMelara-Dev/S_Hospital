<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Concurrent</exclude>
            <!-- The prefix exclusion also matches this sibling filename. Keep
                 its lifecycle checks explicitly alongside the real races. -->
            <file>tests/Feature/ConcurrentFiscalNumberTest.php</file>
        </testsuite>
        <testsuite name="Coverage">
            <directory>tests/Coverage</directory>
        </testsuite>
        <testsuite name="Concurrent">
            <directory>tests/Feature/Concurrent</directory>
        </testsuite>
        <!-- COORD-14 (2026-09-17): paridad con phpunit.xml. Antes el job MariaDB
             omitía por completo las pruebas de consola. -->
        <testsuite name="Console">
            <directory>tests/Console</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_NAME" value="Sistema de Caja Hospitalaria" force="true"/>
        <env name="APP_CONFIG_CACHE" value="storage/framework/testing/config.php" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
