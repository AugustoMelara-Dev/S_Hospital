# =============================================================================
# Sistema de Caja Hospitalaria - Plantilla backend Laravel
# =============================================================================
# Copie este archivo a `backend/.env` y rellene los valores vacios.
# No contenga secretos reales. Las contraseñas se generan con
# `deploy_hospital_lan.ps1` o `php artisan key:generate`.
# =============================================================================

APP_NAME="Sistema de Caja Hospitalaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=local

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN
APP_TIMEZONE=America/Tegucigalpa

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospital_billing
DB_USERNAME=hospital
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sesion, cache, sanctum
# -----------------------------------------------------------------------------
# Demo/local LAN default. Production can override after validating the final server session backend.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Para produccion, regenerar con la IP del servidor. NO usar *.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,::1
SANCTUM_AUTHENTICATE_SESSION=false

# Para produccion, ajustar al host LAN. NO usar *.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_PATTERNS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (placeholder; en LAN offline no se usa SMTP real)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hospital-billing.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS / S3 (no se usa en LAN offline)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Salt para firmar license.json. Dejar vacio usa el default embebido.
# Para produccion, setear 32+ chars aleatorios por hospital. Rotarlo
# invalida firmas previas. Ver docs/SECRETS.md.
# -----------------------------------------------------------------------------
HOSPITAL_LICENSE_SALT=
