# =============================================================================
# Sistema de Caja Hospitalaria - Plantilla backend Laravel
# =============================================================================
# Copie este archivo a `backend/.env` y rellene los valores vacios.
# No contenga secretos reales. Las contraseñas se generan con
# `deploy_hospital_lan.ps1` o `php artisan key:generate`.
# =============================================================================

APP_NAME="Sistema de Caja Hospitalaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_VERSION=local

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN
APP_TIMEZONE=America/Tegucigalpa

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=90

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospital_billing
DB_USERNAME=hospital
DB_PASSWORD=

# Zona horaria de la sesion de conexion MySQL/MariaDB (offset fijo +HH:MM/-HH:MM).
# Default -06:00 (Honduras no tiene DST). Las tablas de zonas horarias con
# nombre pueden no estar cargadas; use offset fijo. No convierte datos
# historicos: solo afecta conexiones nuevas, por lo que requiere reiniciar
# backend/queue-worker/realtime-worker (o recargar config) para tomar efecto.
DB_TIMEZONE=-06:00

# -----------------------------------------------------------------------------
# Sesion, cache, sanctum
# -----------------------------------------------------------------------------
# Demo/local LAN default. Production can override after validating the final server session backend.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Para produccion, regenerar con la IP del servidor. NO usar *.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,::1
SANCTUM_AUTHENTICATE_SESSION=false

# Para produccion, ajustar al host LAN. NO usar *.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_PATTERNS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (placeholder; en LAN offline no se usa SMTP real)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hospital-billing.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS / S3 (no se usa en LAN offline)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Salt para firmar license.json. En local/testing, vacio conserva
# compatibilidad con el default embebido. En produccion, si existe
# license.json, debe setearse con 32+ chars aleatorios por hospital.
# Rotarlo invalida firmas previas. Ver docs/SECRETS.md.
# -----------------------------------------------------------------------------
HOSPITAL_LICENSE_SALT=

# -----------------------------------------------------------------------------
# Operacion local, respaldos y retencion
# -----------------------------------------------------------------------------
HOSPITAL_DUMP_BINARY=
HOSPITAL_DAILY_BACKUP_TIME=02:00
HOSPITAL_OPERATION_START=06:00
HOSPITAL_OPERATION_END=18:00
HOSPITAL_AUDIT_RETENTION_DAYS=365
HOSPITAL_FAILED_JOBS_RETENTION_DAYS=30
HOSPITAL_IDEMPOTENCY_RETENTION_DAYS=30
HOSPITAL_SCHEDULER_TICK_RETENTION_DAYS=7
HOSPITAL_LOGIN_ATTEMPT_RETENTION_DAYS=30
HOSPITAL_CLIENT_ERROR_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Copia externa cifrada (F019/HS-BK-EXT)
# -----------------------------------------------------------------------------
# Desactivada por defecto. Active solo cuando exista un destino real fuera del
# host (USB, disco externo o recurso de red montado en el servidor); un
# directorio del MISMO disco no protege contra la perdida del servidor.
# Sin un destino real montado y verificado, la copia externa NO esta desplegada
# y el sistema no debe declararla como tal.
# Bare-metal: ROOT es la ruta real del destino (p. ej. E:\hospital-backups).
# Docker: este archivo no alimenta al contenedor; la raiz se monta desde la
# raiz del proyecto (HOSPITAL_BACKUP_EXTERNAL_HOST_PATH -> /external-backups)
# y las credenciales no se escriben en ningun .env.
HOSPITAL_BACKUP_EXTERNAL_ENABLED=false
HOSPITAL_BACKUP_EXTERNAL_DISK=backup_external
# Driver del disco externo. Solo 'local' esta soportado; no escriba credenciales.
HOSPITAL_BACKUP_EXTERNAL_DRIVER=local
HOSPITAL_BACKUP_EXTERNAL_ROOT=
HOSPITAL_BACKUP_EXTERNAL_PATH=hospital-backups
HOSPITAL_BACKUP_EXTERNAL_LABEL=externo
HOSPITAL_BACKUP_EXTERNAL_VERIFY=true
# Solo aplica a Docker (root .env/compose): ruta del host que se monta en
# /external-backups. El placeholder ./backup-external es del mismo host y NO
# cuenta como copia externa; use USB, disco externo o recurso de red.
HOSPITAL_BACKUP_EXTERNAL_HOST_PATH=./backup-external

# -----------------------------------------------------------------------------
# Alertas locales de salud de respaldos (HS-BK-ALERT)
# -----------------------------------------------------------------------------
# Horas sin respaldo exitoso, fallos consecutivos y antiguedad de la copia
# externa antes de registrar una alerta local. El canal externo no esta
# desplegado; estas alertas quedan en auditoria/cache del servidor.
HOSPITAL_BACKUP_ALERT_STALE_HOURS=12
HOSPITAL_BACKUP_ALERT_CONSECUTIVE_FAILURES=3
HOSPITAL_BACKUP_ALERT_EXTERNAL_STALE_HOURS=26

# Guard pre-migracion (entrypoint Docker con RUN_MIGRATIONS=true y deploy
# bare-metal): ventana maxima, en horas, para aceptar el ultimo respaldo
# cifrado, integro y recuperable antes de ejecutar migraciones. Default 72.
# Valores no numericos o menores a 1 usan el default. En Docker el valor se
# propaga via docker-compose.prod.yml; sin la variable se conserva 72.
HOSPITAL_MIGRATION_BACKUP_MAX_AGE_HOURS=72
