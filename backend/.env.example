# =============================================================================
# Sistema de Caja Hospitalaria - Plantilla backend Laravel
# =============================================================================
# Copie este archivo a `backend/.env` y rellene los valores vacios.
# No contenga secretos reales. Las contrasenas se generan con
# `deploy_hospital_lan.ps1` o `php artisan key:generate`.
#
# Secciones:
#   1. APP         - nombre, entorno, URL, locale, mantenimiento, hash
#   2. LOG         - canales de bitacora y nivel de verbosidad
#   3. DB          - MariaDB/MySQL de la LAN
#   4. SESSION / CACHE / QUEUE / SANCTUM / CORS - estado de aplicacion
#   5. REDIS / MEMCACHED - caches alternativos (no se usan en LAN offline)
#   6. BROADCAST / PUSHER - Soketi WebSocket (realtime caja)
#   7. FILESYSTEM / VITE - disco y build del frontend
#   8. MAIL        - placeholder log; en LAN offline no se usa SMTP real
#   9. AWS / S3    - no se usa en LAN offline
#  10. HOSPITAL_*  - configuracion especifica del sistema hospitalario
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APP
# -----------------------------------------------------------------------------
APP_NAME="Sistema de Caja Hospitalaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=local

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# 2. LOG
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# 3. DB
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospital_billing
DB_USERNAME=hospital
DB_PASSWORD=

# -----------------------------------------------------------------------------
# 4. SESSION / CACHE / QUEUE / SANCTUM / CORS
# -----------------------------------------------------------------------------
# Demo/local LAN default. Production can override after validating the final server session backend.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Para produccion, regenerar con la IP del servidor. NO usar *.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,::1
SANCTUM_AUTHENTICATE_SESSION=false

# Para produccion, ajustar al host LAN. NO usar *.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_PATTERNS=

# -----------------------------------------------------------------------------
# 5. REDIS / MEMCACHED
# -----------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 6. BROADCAST / PUSHER (Soketi WebSocket)
# -----------------------------------------------------------------------------
# Soketi en LAN escucha 127.0.0.1:6001 y laravel-echo se conecta por http.
# En produccion, el cliente React usa la misma URL base que la API.
BROADCAST_CONNECTION=pusher
PUSHER_APP_KEY=hospital-key
PUSHER_APP_SECRET=hospital-secret
PUSHER_APP_ID=hospital-app
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http

# -----------------------------------------------------------------------------
# 7. FILESYSTEM / QUEUE / CACHE / VITE
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# 8. MAIL (placeholder; en LAN offline no se usa SMTP real)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hospital-billing.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# 9. AWS / S3 (no se usa en LAN offline)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# 10. HOSPITAL_* (configuracion especifica del sistema hospitalario)
# -----------------------------------------------------------------------------
# Contrasena inicial del usuario admin sembrado por RolesAndPermissionsSeeder.
# Si queda vacia, el seeder genera una aleatoria y la imprime una sola vez.
# Definirla aqui fuerza una contrasena conocida solo para el primer arranque.
# Cambiar inmediatamente despues del primer login.
HOSPITAL_INITIAL_ADMIN_PASSWORD=

# Salt para firmar license.json. Dejar vacio usa el default embebido.
# Para produccion, setear 32+ chars aleatorios por hospital. Rotarlo
# invalida firmas previas. Ver docs/SECRETS.md.
HOSPITAL_LICENSE_SALT=

# Binario de mysqldump/mariadb-dump usado por los comandos de backup.
# En el contenedor prod de S_Hospital vive en /usr/bin/mariadb-dump.
HOSPITAL_DUMP_BINARY=/usr/bin/mariadb-dump
