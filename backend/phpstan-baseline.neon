			identifier: nullsafe.neverNull
			count: 1
			path: app/Actions/Cash/BuildCashReconciliationAction.php

		-
			message: '#^Strict comparison using \!\=\= between int and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 2
			path: app/Actions/Payments/RegisterPaymentAction.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 2
			path: app/Actions/Payments/RegisterPaymentAction.php

		-
			message: '#^Offset ''reason'' on array\{reason\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Actions/Payments/VoidPaymentAction.php

		-
			message: '#^Strict comparison using \!\=\= between int and null will always evaluate to true\.$#'
