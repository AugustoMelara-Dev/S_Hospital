parameters:
	ignoreErrors:
		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: app/Actions/Backups/DatabaseDumpWriter.php

		-
			message: '#^Called ''skip'' on Laravel collection, but could have been retrieved as a query\.$#'
			identifier: larastan.noUnnecessaryCollectionCall
			count: 1
			path: app/Actions/Backups/PruneBackupsAction.php

		-
			message: '#^Using nullsafe property access "\?\-\>default_tax_rate" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Actions/Billing/CreateInvoiceAction.php

		-
			message: '#^Access to an undefined property App\\Models\\Invoice\:\:\$invoice_count\.$#'
			identifier: property.notFound
			count: 1
