# Production builds are allowlisted so local QA output, worktrees, logs and
# other untracked files can never inflate or contaminate the image context.
**

# Laravel application runtime.
!backend/
backend/**
!backend/app/
!backend/app/**
!backend/bootstrap/
!backend/bootstrap/app.php
!backend/bootstrap/providers.php
!backend/config/
!backend/config/**
!backend/database/
!backend/database/**
!backend/docker/
!backend/docker/**
!backend/public/
!backend/public/**
!backend/resources/
!backend/resources/**
!backend/routes/
!backend/routes/**
!backend/artisan
!backend/composer.json
!backend/composer.lock
!backend/Dockerfile.prod

# React production build inputs. Tests under src remain included because the
# strict TypeScript build checks them; QA artifacts and browser E2E stay out.
!frontend/
frontend/**
!frontend/.storybook/
!frontend/.storybook/**
!frontend/public/
!frontend/public/**
!frontend/src/
!frontend/src/**
!frontend/vite-plugins/
!frontend/vite-plugins/**
!frontend/scripts/
frontend/scripts/**
!frontend/scripts/check-product-delivery.mjs
# frontend/.env.production NO se incluye a propósito (SEC-01-F1, 2026-09-17):
# el build es same-origin y base.ts:234 trata la variable ausente igual que vacía
# (`?? ''`), así que excluirlo no cambia el comportamiento y evita hornear a la
# imagen cualquier valor futuro de ese archivo. El archivo sigue en disco; debe
# destrackearse con `git rm --cached frontend/.env.production` en el próximo commit.
!frontend/index.html
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/vitest.shims.d.ts
