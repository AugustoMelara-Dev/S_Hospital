# =============================================================================
# Sistema de Caja Hospitalaria - Configuracion raiz para Docker
# =============================================================================
# Este archivo NO contiene secretos. Es la fuente de verdad para los nombres
# de variables que el operador debe poblar antes de levantar el stack.
#
# Para produccion:
#   1. Copie este archivo a `.env` en la raiz del proyecto.
#   2. Cambie TODAS las contraseñas. Los valores de abajo son placeholders
#      intencionalmente vacios para que el instalador los rellene.
#   3. Ajuste SERVER_IP a la IP fija del servidor en la LAN del hospital.
# =============================================================================

# Puerto HTTP publico del sistema dentro del servidor. El default 8000
# puede cambiarse si choca con otro servicio; el instalador detecta
# conflictos y propone alternativas.
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
APP_SCHEME=http
APP_URL=

# Laravel APP_KEY. El instalador genera un valor base64 seguro si se deja vacio.
APP_KEY=

# Puerto del dev server de Vite. Solo se usa durante desarrollo local.
# En produccion NO se publica; ver docker-compose.prod.yml.
FRONTEND_PORT=5173

# IP fija del servidor en la LAN del hospital. CRITICO: si cambia
# despues de un reboot, todos los clientes quedan sin acceso.
SERVER_IP=

# -----------------------------------------------------------------------------
# Base de datos MariaDB
# -----------------------------------------------------------------------------
# DB_PORT interno entre contenedores es siempre 3306. Lo que se publica
# al host es `${DB_PORT:-3306}:3306` y se puede ajustar si se desea.
DB_PORT=3306
DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=hospital_billing
DB_USERNAME=hospital

# CONTRASEÑAS: el instalador genera valores aleatorios de 24 chars
# si se deja vacio. NO usar valores reales en este archivo.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Realtime LAN via Soketi/Pusher protocol
# -----------------------------------------------------------------------------
# El instalador genera valores aleatorios si se dejan vacios. Estos secretos
# deben existir para que docker-compose.prod.yml pueda levantar Soketi y para
# que Laravel firme eventos realtime sin depender de servicios cloud.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
SOKETI_PORT=6001
PUSHER_CLIENT_PORT=6001

# -----------------------------------------------------------------------------
# Cache/locks compartidos entre backend, queue-worker y scheduler
# -----------------------------------------------------------------------------
# Produccion Docker no debe usar CACHE_STORE=file: cada contenedor tendria
# locks y heartbeat propios. Database usa las tablas cache/cache_locks y
# permite bloquear backups y estados operativos de forma consistente.
CACHE_STORE=database
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Seguridad de navegador local/LAN
# -----------------------------------------------------------------------------
# El instalador rellena estos valores con la IP y puerto finales, por ejemplo:
# SANCTUM_STATEFUL_DOMAINS=192.168.1.10,192.168.1.10:8000
# CORS_ALLOWED_ORIGINS=http://192.168.1.10:8000
SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=false
