# Copie este archivo como .env y cambie TODOS los valores antes de producción.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
# Genere con: python -c "import secrets;print(secrets.token_urlsafe(48))"
SHS_SECRET_KEY=change-me
# Clave para cifrar respaldos (AES-256-GCM). Guárdela fuera del servidor: sin ella no se restauran respaldos.
SHS_BACKUP_KEY=change-me
SHS_DAILY_BACKUP_TIME=02:00

# Primer administrador (se crea al iniciar si no existe; deberá cambiar la clave al entrar).
SHS_ADMIN_USERNAME=admin
SHS_ADMIN_NAME=Administrador del sistema
SHS_ADMIN_PASSWORD=

# true = datos de demostración (institución, CAI de prueba, usuarios demo). Nunca en producción.
SHS_SEED_DEMO=false

APP_BIND_IP=0.0.0.0
APP_PORT=8080
