# =============================================================================
# Sistema de Caja Hospitalaria - Configuracion raiz para Docker
# =============================================================================
# Este archivo NO contiene secretos. Es la fuente de verdad para los nombres
# de variables que el operador debe poblar antes de levantar el stack.
#
# Para produccion:
#   1. Copie este archivo a `.env` en la raiz del proyecto.
#   2. Cambie TODAS las contraseñas. Los valores de abajo son placeholders
#      intencionalmente vacios para que el instalador los rellene.
#   3. Ajuste SERVER_IP a la IP fija del servidor en la LAN del hospital.
# =============================================================================

# Puerto HTTP publico del sistema dentro del servidor. El default 8000
# puede cambiarse si choca con otro servicio; el instalador detecta
# conflictos y propone alternativas.
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
APP_URL=

# HTTPS es el modo recomendado para entrega real. Si se mantiene HTTP en LAN,
# debe quedar reconocido explicitamente con HOSPITAL_ALLOW_INSECURE_HTTP=1.
APP_SCHEME=http
HOSPITAL_ALLOW_INSECURE_HTTP=1

# -----------------------------------------------------------------------------
# HTTPS/WSS opcional (overlay docker-compose.tls.yml)
# -----------------------------------------------------------------------------
# 1. Genere la CA local y el certificado del servidor con SAN:
#      powershell -File scripts\generate_local_ca.ps1 -ServerIp <IP-LAN>
# 2. Instale nginx\ssl\hospital-ca.crt.pem como CA de confianza en cada PC.
# 3. Defina HOSPITAL_TLS_ORIGIN con el origen exacto del navegador, sin :443:
#      HOSPITAL_TLS_ORIGIN=https://192.168.1.10
# 4. Active el modo TLS:
#      docker compose -f docker-compose.prod.yml -f docker-compose.tls.yml up -d
# El puerto HTTP de APP_PORT sigue disponible para transicion y rollback; no
# hay redireccion forzada ni HSTS en el puerto 80.
TLS_PORT=443
TLS_BIND_IP=0.0.0.0
HOSPITAL_TLS_ORIGIN=

# Laravel APP_KEY. El instalador genera un valor base64 seguro si se deja vacio.
APP_KEY=

# Puerto del dev server de Vite. Solo se usa durante desarrollo local.
# En produccion NO se publica; ver docker-compose.prod.yml.
FRONTEND_PORT=5173

# IP fija del servidor en la LAN del hospital. CRITICO: si cambia
# despues de un reboot, todos los clientes quedan sin acceso.
SERVER_IP=

# -----------------------------------------------------------------------------
# Base de datos MariaDB
# -----------------------------------------------------------------------------
# DB_PORT interno entre contenedores es siempre 3306. Lo que se publica
# al host es `${DB_PORT:-3306}:3306` y se puede ajustar si se desea.
DB_PORT=3306
DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=hospital_billing
DB_USERNAME=hospital

# CONTRASEÑAS: el instalador genera valores aleatorios de 24 chars
# si se deja vacio. NO usar valores reales en este archivo.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Zona horaria de la sesion de conexion MySQL/MariaDB (offset fijo +HH:MM/-HH:MM).
# Default -06:00 (Honduras no tiene DST). Las tablas de zonas horarias con
# nombre pueden no estar cargadas en el servidor; use offset fijo. No convierte
# datos historicos: solo afecta conexiones nuevas, por lo que requiere recrear
# backend/queue-worker/realtime-worker/scheduler para tomar efecto.
DB_TIMEZONE=-06:00

# -----------------------------------------------------------------------------
# Realtime LAN via Soketi/Pusher protocol
# -----------------------------------------------------------------------------
# El instalador genera valores aleatorios si se dejan vacios. Estos secretos
# deben existir para que docker-compose.prod.yml pueda levantar Soketi y para
# que Laravel firme eventos realtime sin depender de servicios cloud.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
SOKETI_PORT=6001
PUSHER_CLIENT_PORT=6001
PUSHER_CLIENT_SCHEME=http

# -----------------------------------------------------------------------------
# Backups locales cifrados
# -----------------------------------------------------------------------------
# Clave local usada para proteger archivos .sql.gz.enc. El instalador debe
# generar un secreto largo y guardarlo fuera del repositorio. Sin esta clave no
# se podran descifrar backups para restore.
HOSPITAL_BACKUP_ENCRYPTION_KEY=
HOSPITAL_BACKUP_KEEP_MANUAL_SUCCESSFUL=10
HOSPITAL_BACKUP_KEEP_MANUAL_DAYS=30
HOSPITAL_BACKUP_KEEP_SCHEDULED_SUCCESSFUL=96
HOSPITAL_BACKUP_KEEP_SCHEDULED_DAYS=7
HOSPITAL_DAILY_BACKUP_TIME=02:00
HOSPITAL_OPERATION_START=06:00
HOSPITAL_OPERATION_END=18:00
HOSPITAL_AUDIT_RETENTION_DAYS=365
HOSPITAL_FAILED_JOBS_RETENTION_DAYS=30
HOSPITAL_IDEMPOTENCY_RETENTION_DAYS=30
HOSPITAL_SCHEDULER_TICK_RETENTION_DAYS=7
HOSPITAL_LOGIN_ATTEMPT_RETENTION_DAYS=30
HOSPITAL_CLIENT_ERROR_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Copia externa cifrada (F019/HS-BK-EXT)
# -----------------------------------------------------------------------------
# Desactivada por defecto. Active solo cuando exista un destino real fuera del
# host (USB, disco externo o recurso de red montado en el servidor); un
# directorio del MISMO disco no protege contra la perdida del servidor.
# Sin un destino real montado y verificado, la copia externa NO esta desplegada
# y el sistema no debe declararla como tal.
# Docker: HOSPITAL_BACKUP_EXTERNAL_HOST_PATH es la ruta del host que compose
# monta en /external-backups; dentro del contenedor ROOT vale /external-backups.
# Bare-metal: ajuste ROOT a la ruta real del destino (p. ej. E:\hospital-backups).
# Puesta en marcha: 1) apunte HOST_PATH al destino real; 2) ponga ENABLED=true;
# 3) recree el scheduler: docker compose -f docker-compose.prod.yml up -d scheduler;
# 4) compruebe con: docker compose exec -T scheduler php artisan hospital:check-backup-health --json
HOSPITAL_BACKUP_EXTERNAL_ENABLED=false
HOSPITAL_BACKUP_EXTERNAL_DISK=backup_external
# Driver del disco externo. Solo 'local' esta soportado; no escriba credenciales.
HOSPITAL_BACKUP_EXTERNAL_DRIVER=local
HOSPITAL_BACKUP_EXTERNAL_ROOT=
HOSPITAL_BACKUP_EXTERNAL_PATH=hospital-backups
HOSPITAL_BACKUP_EXTERNAL_LABEL=externo
HOSPITAL_BACKUP_EXTERNAL_VERIFY=true
# Solo Docker: ruta del host para el bind /external-backups. Debe ser otro
# dispositivo o un recurso de red, no el disco de datos. El valor por defecto
# ./backup-external es del mismo host y NO cuenta como copia externa.
HOSPITAL_BACKUP_EXTERNAL_HOST_PATH=./backup-external

# -----------------------------------------------------------------------------
# Alertas locales de salud de respaldos (HS-BK-ALERT)
# -----------------------------------------------------------------------------
# Horas sin respaldo exitoso, fallos consecutivos y antiguedad de la copia
# externa antes de registrar una alerta local. El canal externo no esta
# desplegado; estas alertas quedan en auditoria/cache del servidor.
HOSPITAL_BACKUP_ALERT_STALE_HOURS=12
HOSPITAL_BACKUP_ALERT_CONSECUTIVE_FAILURES=3
HOSPITAL_BACKUP_ALERT_EXTERNAL_STALE_HOURS=26
HOSPITAL_BACKUP_ALERT_RECOVERABLE_STALE_HOURS=26

# Para upgrades productivos con datos existentes, el entrypoint y el instalador
# verifican automaticamente un respaldo cifrado, integro y recuperable con
# hospital:verify-migration-backup antes de ejecutar migraciones pendientes.
# No existe confirmacion manual: sin respaldo verificado la migracion se bloquea.
# Ventana maxima (horas) de antiguedad del respaldo; default 72. Valores no
# numericos o menores a 1 usan el default. El instalador y el entrypoint la
# traducen a --max-age-hours al verificar el respaldo.
HOSPITAL_MIGRATION_BACKUP_MAX_AGE_HOURS=72

# -----------------------------------------------------------------------------
# Cache/locks compartidos entre backend, queue-worker y scheduler
# -----------------------------------------------------------------------------
# Produccion Docker no debe usar CACHE_STORE=file: cada contenedor tendria
# locks y heartbeat propios. Database usa las tablas cache/cache_locks y
# permite bloquear backups y estados operativos de forma consistente.
CACHE_STORE=database
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Seguridad de navegador local/LAN
# -----------------------------------------------------------------------------
# El instalador rellena estos valores con la IP y puerto finales, por ejemplo:
# SANCTUM_STATEFUL_DOMAINS=192.168.1.10,192.168.1.10:8000
# CORS_ALLOWED_ORIGINS=http://192.168.1.10:8000
SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=false
