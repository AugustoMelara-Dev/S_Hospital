# =============================================================================
# Sistema de Caja Hospitalaria - Plantilla frontend React (Vite)
# =============================================================================
# Copie este archivo a `frontend/.env` y rellene los valores que apliquen.
# No contenga secretos reales. Las variables VITE_* se exponen al bundle
# del cliente; no incluya claves privadas aqui.
#
# Variables en build de produccion:
#   VITE_API_BASE_URL - URL base del backend Laravel (sin /api al final).
#                       Dejar vacio en LAN: el frontend usa el mismo host
#                       que sirve el bundle y resuelve las llamadas a
#                       `/api/...` y `/sanctum/...` en el mismo origen.
#                       Setear solo si el backend vive en otro host.
#
# Variables solo en desarrollo (npm run dev):
#   VITE_DEV_API_PROXY_TARGET - host:puerto al que Vite redirige las
#                               llamadas /api y /sanctum cuando el dev
#                               server corre fuera de Docker.
# =============================================================================

# Dejar vacio para que el build use /api y /sanctum en el mismo host LAN.
VITE_API_BASE_URL=

# Solo desarrollo Vite: el contenedor frontend resuelve el backend por nombre de servicio.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
