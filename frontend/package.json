{
  "name": "s-hospital-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "check:branding": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/check-branding.ps1",
    "e2e": "playwright test",
    "smoke:real": "playwright test --config=playwright.real.config.ts",
    "visual:smoke": "node ../qa/visual-smoke/phase-12-visual-smoke.mjs"
  },
