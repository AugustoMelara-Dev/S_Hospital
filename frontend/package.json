    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.6",
    "vitest-axe": "^0.1.0"
