{
  "name": "s-hospital-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:ui-legacy": "node scripts/check-no-legacy-ui.mjs --mode=inventory",
    "check:ui-legacy:strict": "node scripts/check-no-legacy-ui.mjs --mode=strict",
    "check:ui-legacy:final": "node scripts/check-no-legacy-ui.mjs --mode=final",
    "check:ui-rules": "node scripts/check-ui-rules.mjs",
    "test:storybook": "vitest run --project storybook",
    "test:clinical": "npm run check:ui-legacy && vitest run NewInvoiceView PaymentModal ReceiptPreview InvoiceHistoryView CashBoxView ReportsView UsersView BackupsView HelpView",
    "visual:clinical": "playwright test e2e/all-buttons-smoke.spec.ts",
    "budget:bundle": "node scripts/report-bundle-budget.mjs",
    "test": "vitest run",
    "test:segmented": "node scripts/run-segmented-tests.mjs",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000",
    "test:coverage:check": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.thresholds.lines=65 --coverage.thresholds.functions=60 --coverage.thresholds.branches=60 --coverage.thresholds.statements=65 --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000",
    "test:critical": "vitest run NewInvoiceView PaymentModal ReceiptPreview InvoiceHistoryView BackupsView ReportsView DashboardView UsersView --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000",
    "test:full:windows": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000",
    "smoke:buttons": "playwright test e2e/all-buttons-smoke.spec.ts",
    "build": "tsc --noEmit && vite build",
    "e2e": "node scripts/run-release-e2e.mjs",
    "test:e2e": "node scripts/run-release-e2e.mjs",
    "e2e:legacy": "playwright test",
    "smoke:real": "playwright test --config=playwright.real.config.ts",
    "visual:smoke": "playwright test e2e/v1-2-visible-ui-a11y.spec.ts",
    "v1-2:before": "playwright test e2e/v1-2-visible-ui-a11y.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "ag-grid-community": "36.0.0",
    "ag-grid-react": "36.0.0",
    "antd": "6.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "1.11.21",
    "echarts": "6.1.0",
    "laravel-echo": "^2.3.4",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.2",
    "pusher-js": "^8.5.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.0",
    "react-router-dom": "^7.15.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/react": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "axe-core": "^4.12.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.61.1",
    "storybook": "10.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.6",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
